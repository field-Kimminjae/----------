
/* --- Example Button (Absolute Top Right) --- */
.btn-top-right {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-main);
    border: none;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 10;
}

.btn-top-right:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
}
