
/* --- Example Manager Styles --- */

.btn-example-icon {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: var(--text-main);
    font-size: 1.2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 10;
}

.btn-example-icon:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
}

.input-field {
    width: 100%;
    padding: 12px 15px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.3);
    color: var(--text-main);
    font-size: 0.95rem;
    font-family: var(--font-body);
    outline: none;
    transition: border-color 0.2s;
}

.input-field:focus {
    border-color: var(--accent);
}

.theme-purple-content .input-field:focus {
    border-color: var(--accent-purple);
}

.example-item-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-align: left;
    gap: 10px;
}

.example-content {
    flex: 1;
}

.example-index {
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-bottom: 2px;
}

.example-jp {
    font-family: 'Noto Sans JP', sans-serif;
    font-weight: bold;
    font-size: 1rem;
    color: var(--text-main);
    margin-bottom: 4px;
}

.example-kr {
    font-size: 0.9rem;
    color: #ccc;
}

.btn-delete-small {
    background: rgba(248, 113, 113, 0.2);
    color: var(--wrong);
    border: 1px solid rgba(248, 113, 113, 0.3);
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
}

.btn-delete-small:hover {
    background: rgba(248, 113, 113, 0.4);
}
